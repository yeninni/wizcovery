{
  "@context": {
    "@version": 1.1,
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "owl": "http://www.w3.org/2002/07/owl#",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "schema": "https://schema.org/",
    "sh": "http://www.w3.org/ns/shacl#",
    "wiz": "https://yeninni.github.io/wizcovery/ontology/wiz/"
  },
  "@graph": [
    {
      "@id": "wiz:",
      "@type": "owl:Ontology",
      "owl:versionInfo": "1.0.0",
      "rdfs:label": {
        "@value": "WIZCOVERY 상품·매장 온톨로지",
        "@language": "ko"
      },
      "rdfs:comment": {
        "@value": "수원KT위즈파크 팀스토어 시연 데이터의 상품, 선수, 마킹지, 등번호, 위치, 서비스, 디자인, 큐레이션 태그, SKU 관계를 JSON-LD로 표현하기 위한 어휘입니다. 가격과 재고는 시연값이며 실제 판매 정보가 아닙니다. 클래스는 schema.org 클래스를 상위 클래스로 두고, ontology.js가 이 문서의 사본을 내장해 그래프를 직렬화하고 무결성을 검증합니다. 사본은 tools/sync-ontology-schema.cjs로 이 파일과 동기화합니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:OntologyGraph",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:Dataset" },
      "rdfs:label": { "@value": "온톨로지 그래프", "@language": "ko" },
      "rdfs:comment": {
        "@value": "toJsonLd()가 내보내는 @graph 문서 자체를 가리키는 클래스입니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:Product",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:Product" },
      "rdfs:label": { "@value": "상품", "@language": "ko" },
      "rdfs:comment": {
        "@value": "매장에서 파는 단위 상품입니다. 사이즈별 재고는 wiz:SKU로 나누어 표현합니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:MarkingKit",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "wiz:Product" },
      "rdfs:label": { "@value": "마킹지", "@language": "ko" },
      "rdfs:comment": {
        "@value": "공통 유니폼에 얹는 선수별 마킹지 단위입니다. 완성품으로 파는 마킹키트 상품은 wiz:Product로 표현하고, 이 클래스는 유니폼과 조합하는 시연용 마킹지를 가리킵니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:Player",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:Person" },
      "rdfs:label": { "@value": "선수", "@language": "ko" },
      "rdfs:comment": {
        "@value": "공개 명단(player-roster.js)에 있는 KT 위즈 선수입니다. 상품 판매 여부와는 별개입니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:JerseyNumber",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:QuantitativeValue" },
      "rdfs:label": { "@value": "등번호", "@language": "ko" },
      "rdfs:comment": {
        "@value": "선수의 등번호 값 개체입니다. 값은 wiz:numberValue로 표기하며, 명단에 등번호가 없는 선수는 이 개체가 없습니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:SKU",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:IndividualProduct" },
      "rdfs:label": { "@value": "사이즈별 SKU", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상품 하나의 사이즈별 재고 단위입니다. 상품과 wiz:hasVariant로 연결합니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:Zone",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:Place" },
      "rdfs:label": { "@value": "매장 구역", "@language": "ko" }
    },
    {
      "@id": "wiz:Service",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:Service" },
      "rdfs:label": { "@value": "매장 서비스", "@language": "ko" },
      "rdfs:comment": {
        "@value": "마킹 작업 공간과 픽업처럼 상품과 함께 이용하는 매장 서비스입니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:Design",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:CreativeWork" },
      "rdfs:label": { "@value": "유니폼 디자인", "@language": "ko" },
      "rdfs:comment": {
        "@value": "홈, 어웨이, 선데이처럼 상품과 마킹지를 묶는 디자인 값입니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:CurationTag",
      "@type": ["owl:Class", "rdfs:Class"],
      "rdfs:subClassOf": { "@id": "schema:DefinedTerm" },
      "rdfs:label": { "@value": "큐레이션 태그", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상황별 추천 묶음을 나타내는 태그입니다. 묶음 판매나 세트 상품이 아니라 개별 상품의 후보를 모은 것입니다.",
        "@language": "ko"
      }
    },
    {
      "@id": "wiz:forPlayer",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "선수", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상품이나 마킹지가 어느 선수를 위한 것인지 연결합니다. 아카이브된 상품은 현역 선수와 연결하지 않습니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:Player" }
    },
    {
      "@id": "wiz:compatibleWith",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "호환 마킹지", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상품과 함께 쓸 수 있는 마킹지입니다. 대상은 반드시 wiz:MarkingKit이어야 합니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:MarkingKit" }
    },
    {
      "@id": "wiz:locatedIn",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "진열 위치", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상품이나 마킹지가 매장 어느 구역에 있는지 연결합니다. 위치를 확인하지 못한 상품에는 이 관계가 없습니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:Zone" }
    },
    {
      "@id": "wiz:appliedAt",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "작업 장소", "@language": "ko" },
      "rdfs:comment": {
        "@value": "마킹 작업이 이루어지는 매장 서비스 공간입니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:MarkingKit" },
      "rdfs:range": { "@id": "wiz:Service" }
    },
    {
      "@id": "wiz:hasDesign",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "디자인", "@language": "ko" },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:Design" }
    },
    {
      "@id": "wiz:taggedAs",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "큐레이션 태그", "@language": "ko" },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:CurationTag" }
    },
    {
      "@id": "wiz:supports",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "이용 서비스", "@language": "ko" },
      "rdfs:comment": {
        "@value": "상품이 이용할 수 있는 매장 서비스입니다. 예를 들어 마킹 작업이 필요 없는 상품만 위즈픽업 대상이 됩니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:Service" }
    },
    {
      "@id": "wiz:hasVariant",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "사이즈 SKU", "@language": "ko" },
      "rdfs:domain": { "@id": "wiz:Product" },
      "rdfs:range": { "@id": "wiz:SKU" }
    },
    {
      "@id": "wiz:hasNumber",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "등번호", "@language": "ko" },
      "rdfs:comment": {
        "@value": "선수와 등번호 값 개체를 연결합니다. 등번호가 공개되지 않은 선수에게는 이 관계가 없습니다.",
        "@language": "ko"
      },
      "rdfs:domain": { "@id": "wiz:Player" },
      "rdfs:range": { "@id": "wiz:JerseyNumber" }
    },
    {
      "@id": "wiz:vocabulary",
      "@type": "owl:ObjectProperty",
      "rdfs:label": { "@value": "따르는 어휘", "@language": "ko" },
      "rdfs:domain": { "@id": "wiz:OntologyGraph" },
      "rdfs:range": { "@id": "owl:Ontology" }
    },
    {
      "@id": "wiz:price",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "금액(원)", "@language": "ko" },
      "rdfs:comment": { "@value": "상품과 마킹지의 시연 가격입니다. 실제 판매 가격이 아닙니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "wiz:stock",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "재고", "@language": "ko" },
      "rdfs:comment": { "@value": "마킹지와 SKU의 시연 재고입니다. 판매 중 재고는 시뮬레이션이 따로 계산합니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "wiz:archived",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "보관 여부", "@language": "ko" },
      "rdfs:comment": { "@value": "이전 시연용으로 보관 처리해 판매와 검색에서 제외한 상품입니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "wiz:storefront",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "사진 상품 여부", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:boolean" }
    },
    {
      "@id": "wiz:productId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "상품 번호", "@language": "ko" },
      "rdfs:comment": { "@value": "catalog.js의 상품 번호입니다. 기존 링크와 데이터셋에서 쓰는 값입니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "wiz:position",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "포지션", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:rosterStatus",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "명단 상태", "@language": "ko" },
      "rdfs:comment": { "@value": "active, development, military 중 하나입니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:kboId",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "KBO 등록 번호", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:sourceUrl",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "출처 URL", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:alias",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "별칭", "@language": "ko" },
      "rdfs:comment": { "@value": "문장 검색에서 함께 찾는 선수 이름입니다.", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:number",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "표기 등번호", "@language": "ko" },
      "rdfs:comment": {
        "@value": "마킹지에 표기하는 등번호의 사본입니다. 선수 개체의 등번호와 어긋나면 검증에서 위반으로 보고합니다.",
        "@language": "ko"
      },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "wiz:numberValue",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "등번호 값", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:integer" }
    },
    {
      "@id": "wiz:design",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "디자인 코드", "@language": "ko" },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:evidence",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "근거", "@language": "ko" },
      "rdfs:comment": {
        "@value": "개체 값의 근거입니다. published_roster_snapshot은 공개 명단, demo_template과 demo는 시연용 가정입니다.",
        "@language": "ko"
      },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:relationEvidence",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": { "@value": "관계별 근거", "@language": "ko" },
      "rdfs:comment": {
        "@value": "관계 이름별 근거를 담은 JSON 리터럴입니다. 관계 자체의 출처를 잃지 않도록 그래프에 함께 남깁니다.",
        "@language": "ko"
      },
      "rdfs:range": { "@id": "rdf:JSON" }
    },
    {
      "@id": "wiz:code",
      "@type": "owl:AnnotationProperty",
      "rdfs:label": { "@value": "검증 코드", "@language": "ko" },
      "rdfs:comment": {
        "@value": "SHACL 형태에 붙이는 검증 리포트 코드입니다. validateOntology()가 결과의 code로 사용합니다.",
        "@language": "ko"
      },
      "rdfs:range": { "@id": "xsd:string" }
    },
    {
      "@id": "wiz:shape/ProductShape",
      "@type": "sh:NodeShape",
      "rdfs:label": { "@value": "상품 필수 값", "@language": "ko" },
      "sh:targetClass": { "@id": "wiz:Product" },
      "sh:property": [
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "schema:name" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": { "@id": "xsd:string" },
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "PRODUCT_NAME_REQUIRED",
          "sh:message": "상품에는 이름이 하나 있어야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:price" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": { "@id": "xsd:integer" },
          "sh:minInclusive": 0,
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "PRODUCT_PRICE_INVALID",
          "sh:message": "상품 가격은 0 이상의 정수여야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:archived" },
          "sh:maxCount": 1,
          "sh:datatype": { "@id": "xsd:boolean" },
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "PRODUCT_ARCHIVED_INVALID",
          "sh:message": "보관 여부는 참이나 거짓 값이어야 합니다."
        }
      ]
    },
    {
      "@id": "wiz:shape/MarkingKitShape",
      "@type": "sh:NodeShape",
      "rdfs:label": { "@value": "마킹지 필수 관계", "@language": "ko" },
      "sh:targetClass": { "@id": "wiz:MarkingKit" },
      "sh:property": [
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:forPlayer" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:class": { "@id": "wiz:Player" },
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "KIT_PLAYER_REQUIRED",
          "sh:message": "마킹지는 선수 한 명과 연결되어야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:locatedIn" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:class": { "@id": "wiz:Zone" },
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "KIT_ZONE_REQUIRED",
          "sh:message": "마킹지에는 진열 위치가 하나 있어야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:appliedAt" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:class": { "@id": "wiz:Service" },
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "KIT_SERVICE_REQUIRED",
          "sh:message": "마킹지에는 마킹 작업 장소가 하나 있어야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:stock" },
          "sh:minCount": 1,
          "sh:datatype": { "@id": "xsd:integer" },
          "sh:minInclusive": 0,
          "sh:severity": { "@id": "sh:Violation" },
          "wiz:code": "KIT_STOCK_INVALID",
          "sh:message": "마킹지 재고는 0 이상의 정수여야 합니다."
        },
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "wiz:number" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": { "@id": "xsd:integer" },
          "sh:severity": { "@id": "sh:Warning" },
          "wiz:code": "KIT_WITHOUT_NUMBER",
          "sh:message": "공개 명단에 등번호가 없어 마킹 전에 등번호 확인이 필요합니다."
        }
      ]
    },
    {
      "@id": "wiz:shape/PlayerShape",
      "@type": "sh:NodeShape",
      "rdfs:label": { "@value": "선수 필수 값", "@language": "ko" },
      "sh:targetClass": { "@id": "wiz:Player" },
      "sh:property": [
        {
          "@type": "sh:PropertyShape",
          "sh:path": { "@id": "schema:name" },
          "sh:minCount": 1,
          "sh:maxCount": 1,
          "sh:datatype": { "@id": "xsd:string" },
          "sh:severity": { "@id": "sh:Violation" },
